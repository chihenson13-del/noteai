# ---------------------------------------------------------------------------
# NoteAI - FRONTEND environment (copy to .env.local). Everything here is PUBLIC:
# Vite embeds VITE_* values in the browser bundle. Never put a provider API key here.
# ---------------------------------------------------------------------------

# Supabase project URL and the *anon/publishable* key (safe to expose; protected by RLS).
# Leave both empty to run in local-only mode: recording, playback, download and local
# library work; sign-in, cloud sync, transcription and AI notes are disabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Show cloud transcription / AI notes / cloud Ask. Only set to true after deploying the process-recording and
# ask-recordings functions and their provider keys (see README).
VITE_CLOUD_AI=false

# Beta gate: set to true to show only the sign-in screen until an access code was used on the device.
VITE_REQUIRE_LOGIN=false

# Which sign-in methods to offer: "code,email" (default), "code" (access codes only, no sign-up UI) or "email".
VITE_AUTH_METHODS=code,email

# Optional links shown in Settings. Leave empty to show them as "not configured".
VITE_PRIVACY_POLICY_URL=
VITE_TERMS_URL=

# ---------------------------------------------------------------------------
# SERVER secrets live in Supabase, NOT in this file. Set them with:
#   supabase secrets set --env-file supabase/functions/.env.secrets
# See supabase/functions/.env.example for the variable list.
# ---------------------------------------------------------------------------
