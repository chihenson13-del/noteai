{
  "name": "noteai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NoteAI - AI-powered audio note taker. Browser-only web app (React + TypeScript + Vite) with a Supabase backend.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/fetch-ondevice-assets.mjs && tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "codes:generate": "node scripts/generate-codes.mjs",
    "codes:report": "node scripts/codes-report.mjs",
    "models:fetch": "node scripts/fetch-ondevice-assets.mjs",
    "build:pages": "node scripts/build-pages.mjs --base /noteai/ --out pages-build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@supabase/supabase-js": "^2.117.3",
    "idb": "^8.0.4",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
