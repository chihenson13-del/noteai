# Server-side secrets for the Edge Functions. NEVER commit a real copy of this file.
# Copy to supabase/functions/.env.secrets (gitignored) and run:
#   supabase secrets set --env-file supabase/functions/.env.secrets
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.

# FREE option: one Groq key (https://console.groq.com) covers both transcription (Whisper large-v3) and notes (Llama).
#   TRANSCRIPTION_PROVIDER=groq
#   SUMMARY_PROVIDER=groq
#   GROQ_API_KEY=...
TRANSCRIPTION_PROVIDER=openai
GROQ_API_KEY=

# Speech-to-text (required for transcription). OpenAI audio transcription API.
OPENAI_API_KEY=
# whisper-1 returns segment timestamps. gpt-4o-transcribe / gpt-4o-mini-transcribe return text only.
TRANSCRIPTION_MODEL=whisper-1

# Summaries / key takeaways / decisions / action items.
# SUMMARY_PROVIDER = anthropic | openai | groq
SUMMARY_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Check your provider's current model list; this default is used when unset.
SUMMARY_MODEL=claude-sonnet-5-5
# Optional: use a different (e.g. cheaper) model for "Ask your recordings". Defaults to SUMMARY_MODEL.
# ASK_MODEL=

# Restrict browser access to your site's origin in production (default "*").
ALLOWED_ORIGIN=https://your-app.example.com
